{
    "name": "thesis/formatter",
    "description": "Thesis Formatter",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Valentin Udaltsov",
            "email": "udaltsov.valentin@gmail.com"
        },
        {
            "name": "Thesis Team",
            "homepage": "https://github.com/orgs/thesis-php/people"
        }
    ],
    "require": {
        "php": "^8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5.53",
        "symfony/var-dumper": "^6.4.21 || ^7.2.3"
    },
    "autoload": {
        "files": [
            "src/format.php",
            "src/formatClass.php",
            "src/formatFunction.php",
            "src/formatParameter.php",
            "src/formatProperty.php",
            "src/formatReflectedClass.php",
            "src/formatReflectedFunction.php",
            "src/formatReflectedParameter.php",
            "src/formatReflectedProperty.php",
            "src/formatReflectedType.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Thesis\\Formatter\\": "tests/"
        }
    },
    "config": {
        "lock": false,
        "sort-packages": true
    }
}
