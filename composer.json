{
    "name": "typhoon/formatter",
    "description": "Typhoon Formatter",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Valentin Udaltsov",
            "email": "udaltsov.valentin@gmail.com"
        },
        {
            "name": "Typhoon Team",
            "homepage": "https://github.com/orgs/typhoon-php/people"
        }
    ],
    "require": {
        "php": "^8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5.53",
        "symfony/var-dumper": "^6.4.21 || ^7.2.3"
    },
    "autoload": {
        "files": [
            "src/format.fn.php",
            "src/formatClass.fn.php",
            "src/formatFunction.fn.php",
            "src/formatParameter.fn.php",
            "src/formatProperty.fn.php",
            "src/formatReflectedClass.fn.php",
            "src/formatReflectedFunction.fn.php",
            "src/formatReflectedParameter.fn.php",
            "src/formatReflectedProperty.fn.php",
            "src/formatReflectedType.fn.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Typhoon\\Formatter\\": "tests/"
        }
    },
    "config": {
        "lock": false,
        "sort-packages": true
    }
}
